PORT=8000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/smart-course-gen
JWT_SECRET=your_super_secret_jwt_key_here # REQUIRED (min 32 chars in production)
ACCESS_TOKEN_TTL=30m           # short-lived access token
REFRESH_TOKEN_TTL_DAYS=30       # rotating refresh token lifetime

# Auth0 (Optional)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Google Sign-In (Optional)
GOOGLE_CLIENT_ID=

# AI Providers (comma-separate several keys to rotate through a pool)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Model IDs -- override when a provider retires a model; no deploy needed.
# Current Groq IDs: https://console.groq.com/docs/deprecations
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o
# Per-attempt deadline for a model call, in ms
AI_TIMEOUT_MS=45000
# Optional: Gemini thinking budget (0 = off, -1 = dynamic). Flash defaults to 0.
GEMINI_THINKING_BUDGET=

# Other Integrations
YOUTUBE_API_KEY=

# One-click guest accounts ("Try the demo") -- off unless explicitly enabled
DEMO_MODE=false
DEMO_TTL_HOURS=24

# Optional: IANA zone used for streak day boundaries when a user has none set
APP_TIMEZONE=UTC
# Optional: ground lesson prompts in the curated RAG corpus
RAG_ENABLED=false
